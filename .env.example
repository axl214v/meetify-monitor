TARGET_URL=https://meetify.cc/api/health
SITE_NAME=Meetify
POLL_INTERVAL=30
PORT=8080
# Public hostname. When set, the app serves HTTPS on :443 itself with an auto-issued and
# auto-renewed Let's Encrypt certificate (needs ports 80 and 443 reachable; no proxy container).
# Leave empty for plain HTTP on PORT.
DOMAIN=
# Optional: contact address for Let's Encrypt expiry notices.
ACME_EMAIL=
SITE_URL=https://meetify.cc
# Admin build only: token for maintenance management (/admin). Leave empty to disable.
ADMIN_TOKEN=
# Admin build only: extra trusted reverse-proxy CIDRs (comma-separated) whose CF-Connecting-IP is honoured.
# Cloudflare ranges are built in; set this only for a proxy of your own in front of the app.
TRUSTED_PROXIES=
