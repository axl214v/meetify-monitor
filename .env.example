TARGET_URL=https://meetify.cc/api/health
SITE_NAME=Meetify
POLL_INTERVAL=30
PORT=8080
SITE_URL=https://meetify.cc
# Admin build only: token for maintenance management (/admin). Leave empty to disable.
ADMIN_TOKEN=
# Admin build only: extra trusted reverse-proxy CIDRs (comma-separated) whose CF-Connecting-IP is honoured.
# Cloudflare ranges are built in; set this only for a proxy of your own in front of the app.
TRUSTED_PROXIES=
